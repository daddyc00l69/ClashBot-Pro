    "aload",
    "a_new",
    "aim",
    "achop_invert",
    "    Invert an image (channel). ::",
    "        out = MAX - image",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_lighter",
    "    Compares the two images, pixel by pixel, and returns a new image containing",
    "    the lighter values. ::",
    "        out = max(image1, image2)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_darker",
    "    Compares the two images, pixel by pixel, and returns a new image containing",
    "    the darker values. ::",
    "        out = min(image1, image2)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_difference",
    "    Returns the absolute value of the pixel-by-pixel difference between the two",
    "    images. ::",
    "        out = abs(image1 - image2)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_multiply",
    "    Superimposes two images on top of each other.",
    "    If you multiply an image with a solid black image, the result is black. If",
    "    you multiply with a solid white image, the image is unaffected. ::",
    "        out = image1 * image2 / MAX",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_screen",
    "    Superimposes two inverted images on top of each other. ::",
    "        out = MAX - ((MAX - image1) * (MAX - image2) / MAX)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_soft_light",
    "    Superimposes two images on top of each other using the Soft Light algorithm",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_hard_light",
    "    Superimposes two images on top of each other using the Hard Light algorithm",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_overlay",
    "    Superimposes two images on top of each other using the Overlay algorithm",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_add",
    "    Adds two images, dividing the result by scale and adding the",
    "    offset. If omitted, scale defaults to 1.0, and offset to 0.0. ::",
    "        out = ((image1 + image2) / scale + offset)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_subtract",
    "    Subtracts two images, dividing the result by scale and adding the offset.",
    "    If omitted, scale defaults to 1.0, and offset to 0.0. ::",
    "        out = ((image1 - image2) / scale + offset)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_add_modulo",
    "uAdd two images, without clipping the result. ::",
    "        out = ((image1 + image2) % MAX)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_subtract_modulo",
    "uSubtract two images, without clipping the result. ::",
    "        out = ((image1 - image2) % MAX)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_and",
    "uLogical AND between two images.",
    "    Both of the images must have mode \"1\". If you would like to perform a",
    "    logical AND on an image with a mode other than \"1\", try",
    "    :py:meth:`~PIL.ImageChops.multiply` instead, using a black-and-white mask",
    "    as the second image. ::",
    "        out = ((image1 and image2) % MAX)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_or",
    "uLogical OR between two images.",
    "    Both of the images must have mode \"1\". ::",
    "        out = ((image1 or image2) % MAX)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "achop_xor",
    "uLogical XOR between two images.",
    "    Both of the images must have mode \"1\". ::",
    "        out = ((bool(image1) != bool(image2)) % MAX)",
    "    :rtype: :py:class:`~PIL.Image.Image`",
    "    ",
    "ablend",
    "uBlend images using constant transparency weight. Alias for",
    "    :py:func:`PIL.Image.blend`.",
    "    :rtype: :py:class:`~PIL.Image.Image`",
