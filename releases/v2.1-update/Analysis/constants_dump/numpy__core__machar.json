    "uMachine parameters for %(title)s",
    "---------------------------------------------------------------------",
    "ibeta=%(ibeta)s it=%(it)s iexp=%(iexp)s ngrd=%(ngrd)s irnd=%(irnd)s",
    "machep=%(machep)s     eps=%(_str_eps)s (beta**machep == epsilon)",
