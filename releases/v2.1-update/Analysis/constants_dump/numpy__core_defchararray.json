    "    See Also",
    "    --------",
    "    equal, not_equal, greater_equal, greater, less",
    "    Examples",
    "    --------",
    "    >>> import numpy as np",
    "    >>> x1 = np.array(['a', 'b', 'c'])",
    "    >>> np.char.less_equal(x1, 'b')",
    "    array([ True,  True, False])",
    "    ",
    "w>u",
